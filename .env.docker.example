# Optional overrides for docker-compose.yml. Copy this file to .env.
# The defaults in Compose are suitable only for local development.
MYSQL_DATABASE=elitepc
MYSQL_USER=elitepc
MYSQL_PASSWORD=elitepc_local_password
MYSQL_ROOT_PASSWORD=elitepc_local_root_password

# Leave APP_KEY empty to generate and persist a local key in the laravel_runtime volume.
# For a shared or deployed environment, set a stable value from: php artisan key:generate --show
APP_KEY=
APP_ENV=local
APP_DEBUG=false
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
VITE_API_URL=http://localhost:8000/api

# Optional: Elite AI is unavailable until a valid server-side key is provided.
GEMINI_API_KEY=
ELITE_AI_AGENT_ENABLED=true
GEMINI_REQUEST_TIMEOUT=30
LOG_LEVEL=info
